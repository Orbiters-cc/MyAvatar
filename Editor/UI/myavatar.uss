.avatar-logo { width: 160px; height: 134px; flex-shrink: 1; overflow: visible; }
.myavatar .content { padding: 18px 24px 18px 24px; }
.section-title { color: #ffffff; font-size: 14px; -unity-font-style: bold; margin-top: 6px; margin-bottom: 8px; white-space: normal; }

/* Drop zone: one surface that morphs between the empty field, the progress bar and the result. Height is sprung in code. */
.drop-zone { background-color: #212121; border-radius: 16px; margin-bottom: 12px; overflow: hidden; transition-property: background-color; transition-duration: 0.16s; }
.drop-zone:hover, .drop-zone.drag-over { background-color: #262626; }
.drop-zone__layer { position: absolute; left: 0; right: 0; top: 0; transform-origin: center top; }
.drop-zone__idle { padding: 22px 12px 18px 12px; align-items: center; }
.drop-icon { width: 32px; height: 38px; margin-bottom: 10px; opacity: 0.85; }
#drop-title { font-size: 14px; -unity-font-style: bold; color: #ffffff; white-space: normal; }
#drop-hint { font-size: 11px; margin-top: 5px; margin-bottom: 10px; white-space: normal; -unity-text-align: middle-center; color: #999999; }
.drop-zone__message { margin-top: 10px; font-size: 11px; color: #c8c8c8; white-space: normal; -unity-text-align: middle-center; }
.drop-zone__message.warning { color: #ffb020; }

.drop-zone__working { padding: 0; }
.drop-zone__track { height: 44px; border-radius: 16px; background-color: #2e2e2e; overflow: hidden; justify-content: center; }
.drop-zone__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 16px; background-color: #00DA6D; }
.drop-zone__shimmer { position: absolute; top: 0; bottom: 0; width: 30%; background-color: rgba(255, 255, 255, 0.07); border-radius: 16px; }
.drop-zone__progress-label { -unity-text-align: middle-center; color: #ffffff; -unity-font-style: bold; font-size: 12px; }

.drop-zone__done { padding: 16px 16px 12px 16px; }
.drop-zone__status, .drop-zone__background { flex-direction: row; align-items: center; }
.drop-zone__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; flex-shrink: 0; background-color: #00DA6D; }
.drop-zone__background .drop-zone__dot { background-color: #8a7dff; }
.drop-zone__status-label { color: #ffffff; -unity-font-style: bold; font-size: 13px; white-space: normal; flex-shrink: 1; }
.drop-zone__background { margin-top: 6px; }
.drop-zone__background-label { color: #b9b1ff; font-size: 11px; white-space: normal; flex-shrink: 1; }
.drop-zone__actions { flex-direction: row; margin-top: 12px; }
.drop-zone__actions .mcb-button { height: 34px; min-height: 34px; margin: 0; }
.drop-zone__actions .drop-zone__undo { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.drop-zone__actions .drop-zone__save { flex-grow: 2; flex-basis: 0; }
.drop-zone__again { flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
#drop-again { font-size: 11px; color: #8c8c8c; margin: 0; padding: 0; }
.drop-zone__link { background-color: rgba(0, 0, 0, 0); border-width: 0; color: #00DA6D; font-size: 11px; margin: 0 0 0 3px; padding: 0; cursor: link; }
.drop-zone__link:hover { color: #3dffa0; }

.mcb-button.pressed { scale: 0.97 0.97; }

/* Textures that still need a slot: one compact row each. */
.texture-card { flex-direction: row; align-items: center; background-color: #212121; border-radius: 10px; padding: 8px 10px 8px 8px; margin-bottom: 6px; }
.texture-preview { width: 34px; height: 34px; margin-right: 10px; flex-shrink: 0; border-radius: 6px; }
.texture-text { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.filename { white-space: normal; color: #ffffff; -unity-font-style: bold; font-size: 12px; }
.reason { white-space: normal; color: #8c8c8c; font-size: 10px; margin-top: 2px; max-height: 26px; overflow: hidden; }
.texture-choose { flex-shrink: 0; max-width: 150px; }

/* Thumbnail: summary row, then the shared photoshoot studio when open. */
.thumbnail-section { margin-top: 18px; }
.thumbnail-actions { flex-direction: row; margin-top: 12px; }
.thumbnail-actions .mcb-button { height: 34px; min-height: 34px; margin: 0; }
.thumbnail-actions .thumbnail-actions__sdk { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.thumbnail-actions .thumbnail-actions__main { flex-grow: 2; flex-basis: 0; }
.thumbnail-status { margin-top: 8px; color: #ff8c59; font-size: 11px; white-space: normal; }
.thumbnail-studio { margin-top: 12px; }
/* VRChat in-game avatar card, measured on the game at 1:1: 228x234, 4px frame, 220x127 image, text centred in the body. */
.vrc-stage { height: 270px; flex-shrink: 0; border-radius: 16px; overflow: hidden; background-color: #0c0e14; border-width: 1px; border-color: rgba(255,255,255,0.05); justify-content: center; }
.vrc-stage__row { flex-direction: row; justify-content: center; align-items: center; }
.vrc-card { width: 228px; height: 234px; flex-shrink: 0; margin: 0 8px; padding: 4px 4px 0 4px; border-radius: 10px; overflow: hidden; background-color: #2e323e; }
.vrc-card--placeholder { opacity: 0.32; }
.vrc-card__media { position: relative; height: 127px; flex-shrink: 0; border-top-left-radius: 7px; border-top-right-radius: 7px; overflow: hidden; background-color: #1a1a1a; }
.vrc-card--placeholder .vrc-card__media { background-color: #242833; }
.vrc-card__image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.vrc-card__empty { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-text-align: middle-center; color: #6f7883; font-size: 11px; }
.vrc-card__live { position: absolute; left: 6px; top: 5px; height: 18px; padding: 0 7px; border-radius: 9px; background-color: rgba(10,12,16,0.7); color: #00DA6D; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 0.6px; }
.vrc-card__badges { position: absolute; right: 6px; top: 2px; flex-direction: row; }
.vrc-card__badge { width: 25px; height: 25px; margin-left: 2px; }
.vrc-card__body { flex-grow: 1; justify-content: center; padding: 0 10px 5px 9px; -unity-background-scale-mode: stretch-to-fill; }
.vrc-card__title { min-height: 39px; }
.vrc-card__title-line { margin: 0; padding: 0; font-size: 19px; -unity-font-style: bold; color: #bababa; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; }
.vrc-card__author { margin: 7px 0 0 0; padding: 0; height: 20px; font-size: 15px; -unity-font-style: bold; color: #55828a; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vrc-card__bar { height: 12px; width: 132px; margin: 7px 0; border-radius: 6px; background-color: #4a4f5c; }
.vrc-card__bar--author { width: 84px; height: 10px; margin: 9px 0 2px 0; background-color: #3c5a60; }
.vrc-card__flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #ffffff; opacity: 0; transition-property: opacity; transition-duration: 0.45s; transition-timing-function: ease-out; }
.vrc-card__flash--on { opacity: 0.85; transition-duration: 0s; }
/* Avatar sections: laid out like the thumbnail studio (cards, captions, links). */
.avatar-section { margin-top: 18px; }
.avatar-section__header { flex-direction: row; align-items: center; }
.avatar-section__title { flex-grow: 1; }
.avatar-section__actions { flex-direction: row; align-items: center; margin-bottom: 2px; }
.avatar-card { margin-bottom: 10px; padding: 12px 14px; border-radius: 14px; background-color: #242424; border-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.avatar-card__header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.avatar-card__title { color: #f2f2f2; font-size: 12px; -unity-font-style: bold; }
.avatar-caption, .avatar-section__note { margin-top: 6px; color: #8f8f8f; font-size: 11px; white-space: normal; }
.avatar-section__note.warning { color: #ffb020; }
.mcb-button.avatar-link { height: 22px; min-height: 22px; margin: 0; padding: 0 8px; border-width: 0; border-radius: 11px; background-color: rgba(0, 0, 0, 0); color: #9a9a9a; font-size: 11px; -unity-font-style: normal; }
.mcb-button.avatar-link:hover { background-color: rgba(255, 255, 255, 0.08); color: #e6e6e6; }
/* Posing */
.posing-toggles { flex-direction: row; margin: 0 -3px; }
.posing-toggles .posing-toggle { margin: 0 3px; }
.posing-list { margin-top: 8px; }
.posing-item { flex-direction: row; align-items: center; min-height: 28px; padding: 0 10px; margin-top: 4px; border-radius: 10px; background-color: #2a2a2a; cursor: link; }
.posing-item:hover { background-color: #333333; }
.posing-item__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; background-color: #00DA6D; }
.posing-item__dot.partial { background-color: #ffb020; }
.posing-item__name { flex-grow: 1; font-size: 12px; color: #ffffff; }
.posing-item__count { font-size: 11px; color: #9a9a9a; }
/* Hair, tail & toes */
.physics-card__hint { margin-top: 4px; margin-left: 2px; }
.physics-row { flex-direction: row; align-items: center; height: 38px; }
.physics-row__label { width: 42px; min-width: 42px; color: #bdbdbd; font-size: 11px; }
.physics-row__control { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.physics-missing { flex-direction: row; align-items: center; margin-top: 10px; padding: 6px 6px 6px 12px; border-radius: 10px; background-color: #1a1a1a; }
.physics-missing__text { flex-grow: 1; flex-shrink: 1; font-size: 11px; color: #bdbdbd; white-space: normal; }
.mcb-button.physics-missing__button { height: 26px; min-height: 26px; margin: 0 0 0 8px; padding: 0 12px; border-radius: 13px; font-size: 11px; flex-shrink: 0; }
/* Parameters */
.parameters-headline { flex-direction: row; align-items: flex-end; margin-bottom: 10px; }
.parameters-total { font-size: 30px; -unity-font-style: bold; color: #ffffff; margin: 0; padding: 0; height: 36px; -unity-text-align: lower-left; }
.parameters-total.warning { color: #ffb020; }
.parameters-unit { flex-grow: 1; margin: 0 0 6px 6px; padding: 0; font-size: 11px; color: #8c8c8c; }
.parameters-chip { margin: 0 0 6px 0; padding: 2px 9px; border-radius: 10px; font-size: 11px; -unity-font-style: bold; color: #00DA6D; background-color: rgba(0, 218, 109, 0.12); }
.parameters-chip.warning { color: #ffb020; background-color: rgba(255, 176, 32, 0.14); }
.parameters-compression { flex-direction: row; align-items: center; margin-top: 14px; padding-top: 12px; border-top-width: 1px; border-color: #2e2e2e; }
.parameters-compression__texts { flex-grow: 1; flex-shrink: 1; margin-right: 12px; }
.parameters-compression__title { font-size: 12px; -unity-font-style: bold; color: #ffffff; }
.parameters-compression__text { margin-top: 2px; font-size: 11px; color: #9a9a9a; white-space: normal; }
/* Footer */
.myavatar-credit { margin: 4px 0 14px 0; }
.drop-zone__ai { position: absolute; top: 6px; right: 8px; width: 28px; height: 28px; border-radius: 14px; align-items: center; justify-content: center; transition-property: background-color, scale; transition-duration: 0.14s, 0.2s; transition-timing-function: ease-out, ease-out-back; }
.drop-zone__ai-icon { width: 18px; height: 18px; --icon-color: #5f5f5f; }
.drop-zone__ai--available { cursor: link; }
.drop-zone__ai--available:hover { background-color: rgba(255, 255, 255, 0.08); }
.drop-zone__ai--available:active { scale: 0.9 0.9; }
.drop-zone__ai--available .drop-zone__ai-icon { --icon-color: #8c8c8c; }
.drop-zone__ai--on .drop-zone__ai-icon { --icon-color: #8a7dff; }
