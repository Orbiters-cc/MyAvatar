.avatar-logo { width: 160px; height: 134px; flex-shrink: 1; overflow: visible; }
.myavatar .content { padding: 18px 24px 18px 24px; }
.section-title { color: #ffffff; font-size: 14px; -unity-font-style: bold; margin-top: 6px; margin-bottom: 8px; white-space: normal; }

/* Drop zone: one surface that morphs between the empty field, the progress bar and the result. Height is sprung in code. */
.drop-zone { background-color: #212121; border-radius: 16px; margin-bottom: 12px; overflow: hidden; transition-property: background-color; transition-duration: 0.16s; }
.drop-zone:hover, .drop-zone.drag-over { background-color: #262626; }
.drop-zone.drop-zone--working, .drop-zone.drop-zone--working:hover { background-color: rgba(0, 0, 0, 0); }
.drop-zone__layer { position: absolute; left: 0; right: 0; top: 0; transform-origin: center top; }
.drop-zone__idle { padding: 22px 12px 18px 12px; align-items: center; }
.drop-icon { width: 32px; height: 38px; margin-bottom: 10px; opacity: 0.85; }
#drop-title { font-size: 14px; -unity-font-style: bold; color: #ffffff; white-space: normal; }
#drop-hint { font-size: 11px; margin-top: 5px; margin-bottom: 10px; white-space: normal; -unity-text-align: middle-center; color: #999999; }
.drop-zone__message { margin-top: 10px; font-size: 11px; color: #c8c8c8; white-space: normal; -unity-text-align: middle-center; }
.drop-zone__message.warning { color: #ffb020; }

.drop-zone__working { padding: 0; }
.drop-zone__track { height: 44px; border-radius: 16px; background-color: #2e2e2e; overflow: hidden; justify-content: center; }
.drop-zone__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 16px; background-color: #00DA6D; }
.drop-zone__shimmer { position: absolute; top: 0; bottom: 0; width: 30%; background-color: rgba(255, 255, 255, 0.07); border-radius: 16px; }
.drop-zone__progress-label { -unity-text-align: middle-center; color: #ffffff; -unity-font-style: bold; font-size: 12px; }
.drop-zone__queued { margin-top: 8px; font-size: 11px; color: #9a9a9a; -unity-text-align: middle-center; white-space: normal; }

.drop-zone__done { padding: 16px 16px 12px 16px; }
.drop-zone__status, .drop-zone__background { flex-direction: row; align-items: center; }
.drop-zone__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; flex-shrink: 0; background-color: #00DA6D; }
.drop-zone__background .drop-zone__dot { background-color: #8a7dff; }
.drop-zone__status-label { color: #ffffff; -unity-font-style: bold; font-size: 13px; white-space: normal; flex-shrink: 1; }
.drop-zone__background { margin-top: 6px; }
.drop-zone__background-label { color: #b9b1ff; font-size: 11px; white-space: normal; flex-shrink: 1; }
.drop-zone__actions { flex-direction: row; margin-top: 12px; }
.drop-zone__actions .mcb-button { height: 34px; min-height: 34px; margin: 0; }
.drop-zone__actions .drop-zone__undo { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.drop-zone__actions .drop-zone__save { flex-grow: 2; flex-basis: 0; }
.drop-zone__again { flex-direction: row; justify-content: center; align-items: center; margin-top: 10px; }
#drop-again { font-size: 11px; color: #8c8c8c; margin: 0; padding: 0; }
.drop-zone__link { background-color: rgba(0, 0, 0, 0); border-width: 0; color: #00DA6D; font-size: 11px; margin: 0 0 0 3px; padding: 0; cursor: link; }
.drop-zone__link:hover { color: #3dffa0; }

.mcb-button.pressed { scale: 0.97 0.97; }

/* Textures that still need a slot: grouped by their most likely material, one compact row each. */
.texture-list { margin-bottom: 6px; }
.texture-list__header { flex-direction: row; align-items: center; justify-content: space-between; margin: 2px 0 4px 2px; }
.texture-list__title { margin: 0; padding: 0; font-size: 11px; color: #9a9a9a; }
.texture-group { margin-bottom: 8px; }
.texture-group__header { flex-direction: row; align-items: center; height: 24px; margin: 0 0 4px 2px; }
.texture-group__title { flex-shrink: 1; margin: 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: #e6e6e6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.texture-group__count { flex-grow: 1; margin: 0 0 0 6px; padding: 0; font-size: 11px; color: #7a7a7a; }
.mcb-button.texture-dismiss { width: 22px; min-width: 22px; height: 22px; min-height: 22px; margin: 0 0 0 4px; padding: 0; border-width: 0; border-radius: 11px; background-color: rgba(0, 0, 0, 0); flex-shrink: 0; align-items: center; justify-content: center; }
.mcb-button.texture-dismiss:hover { background-color: rgba(255, 255, 255, 0.08); }
.texture-dismiss__icon { width: 12px; height: 12px; --icon-color: #7a7a7a; }
.mcb-button.texture-dismiss:hover .texture-dismiss__icon { --icon-color: #e6e6e6; }
.texture-card { flex-direction: row; align-items: flex-start; background-color: #212121; border-radius: 12px; padding: 8px 6px 8px 8px; margin-bottom: 6px; }
.texture-preview { width: 40px; height: 40px; margin-right: 10px; flex-shrink: 0; border-radius: 8px; }
.texture-text { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 4px; }
.filename { white-space: normal; color: #ffffff; -unity-font-style: bold; font-size: 12px; }
.reason { white-space: normal; color: #8c8c8c; font-size: 10px; margin-top: 2px; max-height: 26px; overflow: hidden; }
.texture-actions { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.mcb-button.texture-choose { flex-shrink: 1; max-width: 220px; margin: 0 6px 0 0; }

/* Quick optimization: the offer or the result, then the d4rkAvatarOptimizer suggestion. */
.optimize-card { background-color: #212121; border-radius: 16px; margin-bottom: 10px; }
.optimize-card__header { flex-direction: row; align-items: center; padding: 12px 14px; border-radius: 16px; cursor: link; }
.optimize-card__header:hover { background-color: #262626; }
.optimize-card__chevron { width: 12px; height: 12px; margin-right: 6px; flex-shrink: 0; --icon-color: #8c8c8c; transition-property: rotate; transition-duration: 0.15s; }
.optimize-card--open .optimize-card__chevron { rotate: 90deg; }
.optimize-card__body { padding: 0 14px 14px 32px; }
.optimize-card__row { flex-direction: row; align-items: center; }
.optimize-card__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.optimize-card__heading { flex-direction: row; align-items: center; }
.optimize-card__title { margin: 0; padding: 0; color: #ffffff; -unity-font-style: bold; font-size: 12px; }
.optimize-card__chip { margin: 0 0 0 6px; padding: 1px 7px; border-radius: 9px; font-size: 10px; -unity-font-style: bold; color: #00DA6D; background-color: rgba(0, 218, 109, 0.12); }
.optimize-card__text { margin: 3px 0 0 0; padding: 0; white-space: normal; color: #8c8c8c; font-size: 10px; }
.optimize-card__buttons { flex-direction: row; flex-shrink: 0; }
.mcb-button.optimize-card__button { height: 28px; min-height: 28px; margin: 0 0 0 6px; padding: 0 12px; border-radius: 14px; font-size: 11px; }
/* One column: the text over the full width, then the actions on one line. */
.optimize-suggestion { margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-color: #2e2e2e; }
.optimize-suggestion__text { margin: 0; padding: 0; font-size: 11px; color: #bdbdbd; white-space: normal; }
.optimize-suggestion__disclaimer { margin: 4px 0 0 0; padding: 0; font-size: 10px; color: #6f6f6f; white-space: normal; }
.optimize-suggestion__actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px; }
/* A suggestion here, not a missing requirement: the shared prompt without its warning frame. */
.optimize-suggestion .optimize-suggestion__prompt { margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.optimize-suggestion .orb-dependency { flex-direction: column; align-items: stretch; flex-wrap: nowrap; }
.optimize-suggestion .orb-dependency__texts { flex-basis: auto; flex-grow: 0; min-width: 0; margin: 0; }
.optimize-suggestion .orb-dependency__title { font-size: 11px; -unity-font-style: normal; color: #bdbdbd; }
.optimize-suggestion .orb-dependency__install { margin: 0 6px 0 0; }
.mcb-button.optimize-suggestion__button { height: 24px; min-height: 24px; margin: 0 6px 0 0; padding: 0 10px; border-radius: 12px; font-size: 11px; flex-shrink: 0; }
.mcb-button.optimize-suggestion__link { flex-shrink: 0; }

/* Thumbnail: summary row, then the shared photoshoot studio when open. */
.thumbnail-section { margin-top: 18px; }
.thumbnail-actions { flex-direction: row; margin-top: 12px; }
.thumbnail-actions .mcb-button { height: 34px; min-height: 34px; margin: 0; }
.thumbnail-actions .thumbnail-actions__sdk { flex-grow: 1; flex-basis: 0; margin-right: 10px; }
.thumbnail-actions .thumbnail-actions__main { flex-grow: 2; flex-basis: 0; }
.thumbnail-status { margin-top: 8px; color: #ff8c59; font-size: 11px; white-space: normal; }
.thumbnail-studio { margin-top: 12px; }
/* VRChat in-game avatar card, measured on the game at 1:1: 228x234, 4px frame, 220x127 image, text centred in the body. */
.vrc-stage { height: 270px; flex-shrink: 0; border-radius: 16px; overflow: hidden; background-color: #0c0e14; border-width: 1px; border-color: rgba(255,255,255,0.05); justify-content: center; }
.vrc-stage__row { flex-direction: row; justify-content: center; align-items: center; }
.vrc-card { width: 228px; height: 234px; flex-shrink: 0; margin: 0 8px; padding: 4px 4px 0 4px; border-radius: 10px; overflow: hidden; background-color: #2e323e; }
.vrc-card--placeholder { opacity: 0.32; }
.vrc-card__media { position: relative; height: 127px; flex-shrink: 0; border-top-left-radius: 7px; border-top-right-radius: 7px; overflow: hidden; background-color: #1a1a1a; }
.vrc-card--placeholder .vrc-card__media { background-color: #242833; }
.vrc-card__image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.vrc-card__empty { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-text-align: middle-center; color: #6f7883; font-size: 11px; }
.vrc-card__live { position: absolute; left: 6px; top: 5px; height: 18px; padding: 0 7px; border-radius: 9px; background-color: rgba(10,12,16,0.7); color: #00DA6D; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 0.6px; }
.vrc-card__badges { position: absolute; right: 6px; top: 2px; flex-direction: row; }
.vrc-card__badge { width: 25px; height: 25px; margin-left: 2px; }
.vrc-card__body { flex-grow: 1; justify-content: center; padding: 0 10px 5px 9px; -unity-background-scale-mode: stretch-to-fill; }
.vrc-card__title { min-height: 39px; }
.vrc-card__title-line { margin: 0; padding: 0; font-size: 19px; -unity-font-style: bold; color: #bababa; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; }
.vrc-card__author { margin: 7px 0 0 0; padding: 0; height: 20px; font-size: 15px; -unity-font-style: bold; color: #55828a; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vrc-card__bar { height: 12px; width: 132px; margin: 7px 0; border-radius: 6px; background-color: #4a4f5c; }
.vrc-card__bar--author { width: 84px; height: 10px; margin: 9px 0 2px 0; background-color: #3c5a60; }
.vrc-card__flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #ffffff; opacity: 0; transition-property: opacity; transition-duration: 0.45s; transition-timing-function: ease-out; }
.vrc-card__flash--on { opacity: 0.85; transition-duration: 0s; }
/* Avatar sections: laid out like the thumbnail studio (cards, captions, links). */
.avatar-section { margin-top: 18px; }
.avatar-section__header { flex-direction: row; align-items: center; }
.avatar-section__title { flex-grow: 1; }
.avatar-section__actions { flex-direction: row; align-items: center; margin-bottom: 2px; }
.avatar-card { margin-bottom: 10px; padding: 12px 14px; border-radius: 16px; background-color: #242424; border-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.avatar-card__header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.avatar-card__title { color: #f2f2f2; font-size: 12px; -unity-font-style: bold; }
.avatar-caption, .avatar-section__note { margin-top: 6px; color: #8f8f8f; font-size: 11px; white-space: normal; }
.avatar-section__note.warning { color: #ffb020; }
.mcb-button.avatar-link { height: 22px; min-height: 22px; margin: 0; padding: 0 8px; border-width: 0; border-radius: 11px; background-color: rgba(0, 0, 0, 0); color: #9a9a9a; font-size: 11px; -unity-font-style: normal; }
.mcb-button.avatar-link:hover { background-color: rgba(255, 255, 255, 0.08); color: #e6e6e6; }
/* Posing */
.posing-toggles { flex-direction: row; margin: 0 -3px; }
.posing-toggles .posing-toggle { margin: 0 3px; }
.posing-list { margin-top: 8px; }
.posing-item { flex-direction: row; align-items: center; min-height: 28px; padding: 0 10px; margin-top: 4px; border-radius: 12px; background-color: #2a2a2a; cursor: link; }
.posing-item:hover { background-color: #333333; }
.posing-item__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; background-color: #00DA6D; }
.posing-item__dot.partial { background-color: #ffb020; }
.posing-item__name { flex-grow: 1; font-size: 12px; color: #ffffff; }
.posing-item__count { font-size: 11px; color: #9a9a9a; }
/* Hair, tail & toes */
.physics-grid { flex-direction: row; flex-wrap: wrap; margin: 0 -5px; }
.physics-card { flex-grow: 0; flex-shrink: 0; margin: 0 5px 10px 5px; }
.physics-card__title { color: #f2f2f2; font-size: 13px; -unity-font-style: bold; }
.physics-card__label { margin: 6px 0 5px 2px; color: #bdbdbd; font-size: 11px; }
.physics-card__hint { margin-top: 6px; margin-left: 2px; }
.physics-stretch { flex-direction: row; align-items: center; height: 26px; margin-top: 10px; }
.physics-card__label.physics-stretch__label { width: 46px; min-width: 46px; margin: 0 0 0 2px; }
.physics-stretch .unity-base-slider { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 8px 0 0; }
.physics-stretch .unity-base-slider__dragger { width: 14px; height: 14px; border-radius: 7px; margin-top: -6px; background-color: #00DA6D; border-width: 0; }
.physics-stretch .unity-base-slider__tracker { height: 4px; border-radius: 2px; margin-top: -1px; background-color: #1a1a1a; border-width: 0; }
.physics-stretch:disabled { opacity: 0.45; }
.physics-stretch:disabled .unity-base-slider__dragger { background-color: #666666; }
.physics-stretch__value { width: 40px; min-width: 40px; margin: 0; padding: 0; font-size: 11px; color: #ffffff; -unity-text-align: middle-right; -unity-font-style: bold; }
.physics-missing { flex-direction: row; align-items: center; margin-top: 10px; padding: 6px 6px 6px 12px; border-radius: 12px; background-color: #1a1a1a; }
.physics-missing__text { flex-grow: 1; flex-shrink: 1; font-size: 11px; color: #bdbdbd; white-space: normal; }
.mcb-button.physics-missing__button { height: 26px; min-height: 26px; margin: 0 0 0 8px; padding: 0 12px; border-radius: 13px; font-size: 11px; flex-shrink: 0; }
/* Parameters */
/* Footer */
.myavatar-credit { margin: 4px 0 14px 0; }
.drop-zone__ai { position: absolute; top: 6px; right: 8px; width: 28px; height: 28px; border-radius: 14px; align-items: center; justify-content: center; transition-property: background-color, scale; transition-duration: 0.14s, 0.2s; transition-timing-function: ease-out, ease-out-back; }
.drop-zone__ai-icon { width: 18px; height: 18px; --icon-color: #5f5f5f; }
.drop-zone__ai--available { cursor: link; }
.drop-zone__ai--available:hover { background-color: rgba(255, 255, 255, 0.08); }
.drop-zone__ai--available:active { scale: 0.9 0.9; }
.drop-zone__ai--available .drop-zone__ai-icon { --icon-color: #8c8c8c; }
.drop-zone__ai--on .drop-zone__ai-icon { --icon-color: #8a7dff; }
/* Bottom toolbar, like MCB's */
.myavatar-toolbar { margin: 0; height: 22px; flex-shrink: 0; }
/* Versioning: Unit Git in miniature */
.git-summary { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
.git-summary__spacer { flex-grow: 1; }
.git-summary__remote { font-size: 11px; color: #9a9a9a; margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.git-summary__remote.warning { color: #ffb020; }
.git-chip { flex-direction: row; align-items: center; height: 20px; margin: 0 5px 2px 0; padding: 0 8px; border-radius: 10px; background-color: #1a1a1a; }
.git-chip.warning .git-chip__text { color: #ffb020; }
.git-chip__icon { width: 12px; height: 12px; margin-right: 4px; --icon-color: #00DA6D; }
.git-chip__text { margin: 0; padding: 0; font-size: 11px; color: #d6d6d6; }
.git-graph { border-radius: 8px; background-color: #1a1a1a; padding: 2px 8px 2px 4px; }
.git-commit { flex-direction: row; align-items: center; height: 20px; }
.git-lane { width: 16px; height: 20px; flex-shrink: 0; align-items: center; justify-content: center; }
.git-lane__line { position: absolute; left: 7px; width: 2px; top: 0; bottom: 0; background-color: #3a3a3a; }
.git-lane__line--first { top: 10px; }
.git-lane__line--last { bottom: 10px; }
.git-lane__dot { width: 8px; height: 8px; border-radius: 4px; background-color: #6f6f6f; }
.git-lane__dot--head { width: 10px; height: 10px; border-radius: 5px; background-color: #00DA6D; border-width: 2px; border-color: #1a1a1a; }
.git-commit__subject { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 0 0 4px; padding: 0; font-size: 11px; color: #e0e0e0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.git-commit__release { margin: 0 0 0 6px; padding: 0 6px; height: 15px; border-radius: 8px; font-size: 10px; color: #8a7dff; background-color: rgba(138, 125, 255, 0.14); -unity-text-align: middle-center; flex-shrink: 0; }
.git-commit__date { width: 34px; margin: 0 0 0 6px; padding: 0; font-size: 10px; color: #7a7a7a; -unity-text-align: middle-right; flex-shrink: 0; }
.git-setup { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px; }
.git-setup__text { flex-shrink: 1; margin: 0 6px 0 0; padding: 0; font-size: 11px; color: #bdbdbd; }
.git-setup__text--wrap { flex-grow: 1; flex-basis: 0; min-width: 160px; white-space: normal; margin-bottom: 4px; }
.mcb-button.git-button { height: 24px; min-height: 24px; margin: 0 4px 0 0; padding: 0 10px; border-radius: 12px; font-size: 11px; background-color: #3a3a3a; flex-shrink: 0; }
.mcb-button.git-button:hover { background-color: #4a4a4a; }
.mcb-button.git-button--primary { background-color: #00DA6D; color: #06140c; -unity-font-style: bold; }
.mcb-button.git-button--primary:hover { background-color: #19e27d; }
.git-link { flex-wrap: nowrap; }
.git-link__field { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 6px 0 0; }
.git-link__field > .unity-text-field__input { min-height: 24px; border-radius: 8px; background-color: #1a1a1a; border-color: #333333; }
.posing-toggle__badge { position: absolute; top: 2px; right: 2px; margin: 0; }
.accessory-choice { padding: 10px 12px; margin-bottom: 8px; border-radius: 16px; background-color: #2a2a2a; }
.accessory-choice__title { font-size: 12px; color: #ffffff; margin-bottom: 8px; white-space: normal; }
.accessory-choice__row { flex-direction: row; }
.accessory-choice__row > .mcb-button { flex-grow: 1; margin: 0 3px; }
.accessory-note { flex-direction: row; align-items: center; min-height: 26px; padding: 3px 10px; margin-top: 4px; border-radius: 12px; background-color: #262626; }
.accessory-note__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; flex-shrink: 0; background-color: #6f6f6f; }
.accessory-note__dot.warning { background-color: #ffb020; }
.accessory-note__text { flex-grow: 1; flex-shrink: 1; font-size: 11px; color: #d0d0d0; white-space: normal; }
.accessory-list { margin-top: 6px; }
.accessory-list__title { font-size: 11px; color: #9a9a9a; margin: 6px 2px 2px 2px; }
.accessory-list__cost { font-size: 10px; color: #7a7a7a; margin: 6px 2px 0 2px; white-space: normal; }
.accessory-entry { margin-top: 4px; border-radius: 12px; background-color: #2a2a2a; }
.accessory-item { flex-direction: row; align-items: center; min-height: 30px; padding: 0 6px 0 10px; }
.accessory-item__picture { width: 72px; height: 72px; margin: 6px 12px 6px -4px; flex-shrink: 0; border-radius: 12px; overflow: hidden; background-color: #212123; opacity: 0.35; transition-property: opacity; transition-duration: 0.3s; }
.accessory-item__picture.orb-thumbnail--shown { opacity: 1; }
.accessory-entry__notes { padding: 0 6px 6px 6px; }
.accessory-textures { margin: 0 10px 8px 10px; color: #bcbcbc; }
.accessory-textures__material { font-size: 10px; color: #969696; margin-top: 5px; margin-bottom: 3px; }
.accessory-textures__row { flex-direction: row; align-items: center; padding: 5px; margin-bottom: 3px; border-radius: 8px; background-color: #232323; }
.accessory-textures__image { width: 32px; height: 32px; margin-right: 8px; flex-shrink: 0; }
.accessory-textures__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.accessory-textures__role { font-size: 11px; color: #eeeeee; }
.accessory-textures__name { font-size: 10px; color: #999999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.accessory-entry__notes > .accessory-note { margin-top: 2px; background-color: #232323; }
.accessory-item__body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.accessory-item__top { flex-direction: row; align-items: center; min-height: 24px; }
.accessory-item__spacer { flex-grow: 1; min-width: 4px; }
.accessory-item__name { font-size: 12px; -unity-font-style: bold; color: #ffffff; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.accessory-item__how { margin-top: 4px; font-size: 11px; color: #9a9a9a; white-space: normal; }
.accessory-button { height: 22px; min-width: 0; padding: 0 8px; margin: 0 0 0 4px; font-size: 11px; flex-shrink: 0; }
.accessory-choice__cards { flex-direction: row; flex-wrap: wrap; }
.accessory-option { margin-top: 4px; margin-bottom: 4px; padding: 6px; border-radius: 12px; background-color: #232323; align-items: stretch; }
.accessory-option__picture { height: 100px; border-radius: 10px; overflow: hidden; background-color: #212123; opacity: 0.35; transition-property: opacity; transition-duration: 0.3s; }
.accessory-option__picture.orb-thumbnail--shown { opacity: 1; }
.accessory-option__name { margin: 6px 2px 6px 2px; font-size: 11px; color: #ffffff; white-space: normal; -unity-text-align: middle-center; }
.accessory-button.accessory-option__button { margin: 0; }
.accessory-choice__actions { flex-direction: row; justify-content: flex-end; align-items: center; margin-top: 8px; }
.accessory-choice__actions > .mcb-button { height: 24px; min-height: 24px; padding: 0 12px; margin: 0 0 0 6px; border-radius: 12px; }

/* One corner radius for every frame of the window: 16 px for frames (sign-in, drop fields, cards, stages), 12 px for
   rows inside them. The shared sign-in card and photoshoot studio follow here. */
.myavatar .orb-signin { border-radius: 16px; }
.myavatar .ps-stage { border-radius: 16px; }

/* Undo and Save fold away once the set is saved, and come back with the next change. */
.drop-zone__actions { opacity: 1; scale: 1 1; transition-property: opacity, scale; transition-duration: 0.18s; transition-timing-function: ease-out; }
.drop-zone__actions--hiding { opacity: 0; scale: 0.96 0.96; }

/* Tools: one tile per tool, like the photoshoot's buttons. */
.tools-row { flex-direction: row; flex-wrap: wrap; margin-bottom: -8px; }
.tools-tile { flex-grow: 0; flex-basis: auto; width: 104px; margin: 0 8px 8px 0; }
.tools-tile__badge { position: absolute; top: 6px; right: 6px; padding: 1px 6px; border-radius: 8px; font-size: 9px; -unity-font-style: bold; color: #00DA6D; background-color: rgba(0, 218, 109, 0.14); }

/* Pages: the main page and the asset gallery slide into each other (MyAvatarEditor.ShowPage). */
.myavatar-page { opacity: 1; translate: 0 0; transition-property: opacity, translate; transition-duration: 0.22s; transition-timing-function: ease-out; }
.myavatar-page--left { opacity: 0; translate: -28px 0; }
.myavatar-page--right { opacity: 0; translate: 28px 0; }

/* Gallery assets in "On this avatar" */
.accessory-item__gallery { margin: 0 0 0 6px; padding: 1px 7px; border-radius: 9px; font-size: 10px; -unity-font-style: bold; color: #b9b1ff; background-color: rgba(138, 125, 255, 0.14); flex-shrink: 0; }
