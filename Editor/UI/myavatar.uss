.avatar-logo { width: 160px; height: 134px; flex-shrink: 1; overflow: visible; }
.myavatar .content { padding: 18px 24px 18px 24px; }
.section-title { color: #ffffff; font-size: 14px; -unity-font-style: bold; margin-top: 6px; margin-bottom: 8px; white-space: normal; }
#intro { white-space: normal; color: #c8c8c8; font-size: 12px; margin-bottom: 14px; }
.texture-drop { padding: 22px 12px 18px 12px; align-items: center; background-color: #212121; border-radius: 16px; margin-bottom: 12px; transition-property: background-color; transition-duration: 0.16s; }
.texture-drop:hover, .texture-drop.drag-over { background-color: #292929; }
.drop-icon { width: 32px; height: 38px; margin-bottom: 10px; opacity: 0.85; }
#drop-title { font-size: 14px; -unity-font-style: bold; color: #ffffff; white-space: normal; }
#drop-hint { font-size: 11px; margin-top: 5px; margin-bottom: 10px; white-space: normal; -unity-text-align: middle-center; color: #999999; }
.muted { color: #999999; font-size: 11px; white-space: normal; margin-top: 6px; margin-bottom: 8px; }
.progress { color: #00DA6D; white-space: normal; }
.actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 10px; }
.actions Button { flex-grow: 1; margin-right: 6px; }
.texture-card { background-color: #212121; border-radius: 8px; padding: 14px; margin-top: 8px; }
.texture-heading { flex-direction: row; align-items: center; }
.texture-preview { width: 38px; height: 38px; margin-right: 9px; }
.filename { white-space: normal; flex-shrink: 1; color: #ffffff; -unity-font-style: bold; }
.applied-line { white-space: normal; margin-top: 7px; font-size: 11px; color: #c8c8c8; }
.myavatar Foldout { margin-top: 8px; }
