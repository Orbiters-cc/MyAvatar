/* An accessory's fit on the avatar's custom base (FitCard). Blue: a question; green: done; amber: worth a look. */

.fit-card {
    margin: 6px 0 2px 0;
    padding: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #2a323c;
    background-color: #1b2027;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, translate, scale, border-color, background-color;
    transition-duration: 0.3s, 0.45s, 0.45s, 0.25s, 0.25s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out, ease-out;
}

.fit-card--enter {
    opacity: 0;
    translate: 0 10px;
    scale: 0.97 0.97;
}

.fit-card--warning { border-color: #5a4722; background-color: #211e18; }
.fit-card--error { border-color: #5c2b2b; background-color: #221a1a; }
.fit-card--running { border-color: #2c4a6e; }

/* Header: badge, title, version, close. */
.fit-card__header { flex-direction: row; align-items: center; }

.fit-card__badge {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgba(77, 163, 255, 0.16);
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-back;
}

.fit-card__badge--pop { scale: 0.2 0.2; }

.fit-icon { width: 16px; height: 16px; }
.fit-card__spinner { width: 18px; height: 18px; }

.fit-card__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12.5px;
    -unity-font-style: bold;
    color: #f2f5f8;
    white-space: normal;
}

.fit-card__version {
    flex-shrink: 0;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 10px;
    color: #8fa0b2;
    background-color: #262e38;
}

.fit-card__close {
    width: 22px;
    height: 22px;
    margin: 0 0 0 4px;
    padding: 5px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.1s;
}

.fit-card__close .orb-icon { width: 12px; height: 12px; --icon-color: #7d8a97; }
.fit-card__close:hover { background-color: #2a323c; }
.fit-card__close:hover .orb-icon { --icon-color: #d3dbe3; }
.fit-card__close.fit-pressed { scale: 0.9 0.9; }

.fit-card__detail {
    margin: 6px 0 0 38px;
    font-size: 11px;
    color: #a5b1bd;
    white-space: normal;
}

/* The blendshapes it would get. */
.fit-card__chips { flex-direction: row; flex-wrap: wrap; margin: 8px 0 0 38px; }

.fit-chip {
    margin: 0 4px 4px 0;
    padding: 2px 8px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(77, 163, 255, 0.28);
    background-color: rgba(77, 163, 255, 0.1);
    font-size: 10px;
    color: #a9d0ff;
}

.fit-chip--more { color: #8fa0b2; border-color: #34404d; background-color: #232a33; }

/* The two answers of the question. */
.fit-card__tiles { flex-direction: row; margin-top: 10px; }

.fit-tile {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 58px;
    margin: 0;
    padding: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-radius: 12px;
    border-color: #2e3743;
    background-color: #232a33;
    background-image: none;
    translate: 0 0;
    scale: 1 1;
    transition-property: background-color, border-color, translate, scale;
    transition-duration: 0.16s, 0.16s, 0.2s, 0.1s;
    transition-timing-function: ease-out, ease-out, ease-out-back, ease-out;
}

.fit-tile--yes { margin-right: 6px; }
.fit-tile:hover { background-color: #29323d; translate: 0 -1px; }
.fit-tile--yes:hover { border-color: #34d38c; }
.fit-tile--refit:hover { border-color: #4da3ff; }
.fit-tile.fit-pressed { scale: 0.97 0.97; translate: 0 0; }
.fit-tile:disabled { opacity: 0.5; }

.fit-tile__icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 9px;
    align-items: center;
    justify-content: center;
}

.fit-tile__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.fit-tile__title { font-size: 12px; -unity-font-style: bold; color: #eef2f6; -unity-text-align: middle-left; white-space: normal; }
.fit-tile__subtitle { margin-top: 2px; font-size: 10.5px; color: #93a1af; -unity-text-align: middle-left; white-space: normal; }

/* Buttons. */
.fit-card__actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 10px 0 0 38px; }

.fit-btn {
    height: 28px;
    margin: 0 6px 0 0;
    padding: 0 14px;
    border-width: 0;
    border-radius: 8px;
    background-color: #2c343e;
    background-image: none;
    color: #e6ebf0;
    font-size: 11.5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: background-color, color, scale;
    transition-duration: 0.12s, 0.12s, 0.1s;
}

.fit-btn:hover { background-color: #36404c; }
.fit-btn.fit-pressed { scale: 0.96 0.96; }
.fit-btn:disabled { opacity: 0.45; }
.fit-btn--primary { background-color: #2f7df6; color: #ffffff; }
.fit-btn--primary:hover { background-color: #4690ff; }
.fit-btn--ghost { border-width: 1px; border-color: #34404d; background-color: rgba(0, 0, 0, 0); color: #a9b6c3; }
.fit-btn--ghost:hover { background-color: #262e38; color: #e6ebf0; }
.fit-btn--small { height: 22px; padding: 0 10px; font-size: 10.5px; margin: 0 0 0 8px; flex-shrink: 0; }

.fit-card__callout {
    margin: 8px 0 0 38px;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 184, 64, 0.25);
    background-color: rgba(255, 184, 64, 0.08);
}

.fit-card__callout-text { font-size: 10.5px; color: #ffd48a; white-space: normal; }

/* Lining up with the original body. */
.fit-step { margin: 8px 0 0 0; }
.fit-step__line { flex-direction: row; align-items: center; }

.fit-step__number {
    width: 20px;
    height: 20px;
    margin: 0 10px 0 4px;
    flex-shrink: 0;
    border-radius: 10px;
    background-color: rgba(77, 163, 255, 0.16);
    color: #8fc4ff;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.fit-step__text { flex-grow: 1; flex-shrink: 1; font-size: 11px; color: #c9d3dc; white-space: normal; }
.fit-card__tightness { margin: 6px 0 0 34px; }

/* A refit at work. */
.fit-card__track {
    height: 6px;
    margin: 12px 0 0 38px;
    border-radius: 3px;
    overflow: hidden;
    background-color: #262e38;
}

.fit-card__fill {
    height: 100%;
    width: 0;
    border-radius: 3px;
    overflow: hidden;
    background-color: #4da3ff;
    transition-property: width;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.fit-card__shimmer {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    left: -60px;
    background-color: rgba(255, 255, 255, 0.28);
}

.fit-card__progress { margin: 6px 0 0 38px; font-size: 10.5px; color: #93a1af; white-space: normal; }

/* The accessory's fit in its list row. */
.fit-status {
    margin-left: 6px;
    padding: 1px 7px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.fit-status--fitted { color: #6fe0a0; background-color: rgba(52, 211, 140, 0.14); }
.fit-status--question { color: #8fc4ff; background-color: rgba(77, 163, 255, 0.14); }
.fit-status--working { color: #8fc4ff; background-color: rgba(77, 163, 255, 0.14); }
