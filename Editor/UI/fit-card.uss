/* An accessory's fit on the avatar's custom base (FitCard), in My Avatar's palette: green accent, neutral greys, amber
   for what is worth a look, red for a failure. Presses scale like the photoshoot's buttons. */

.fit-card {
    margin: 6px 0 2px 0;
    padding: 12px;
    border-radius: 12px;
    border-width: 0;
    background-color: #212121;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    transition-property: opacity, translate, scale, background-color;
    transition-duration: 0.3s, 0.45s, 0.45s, 0.25s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out;
}

.fit-card--enter {
    opacity: 0;
    translate: 0 10px;
    scale: 0.97 0.97;
}

.fit-card--warning { background-color: #262219; }
.fit-card--error { background-color: #271c1c; }

/* Header: badge, title, version, close. */
.fit-card__header { flex-direction: row; align-items: center; }

.fit-card__badge {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 9px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 218, 109, 0.14);
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-back;
}

.fit-card__badge--pop { scale: 0.2 0.2; }

.fit-icon { width: 16px; height: 16px; }
.fit-card__spinner { width: 18px; height: 18px; }

.fit-card__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12.5px;
    -unity-font-style: bold;
    color: #f2f2f2;
    white-space: normal;
}

.fit-base {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
    margin-left: 6px;
    padding: 0 8px 0 2px;
    border-radius: 11px;
    background-color: #1a1a1a;
}

.fit-base__picture {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    border-radius: 9px;
    background-color: #2e2e2e;
    overflow: hidden;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.fit-base__picture.orb-thumbnail--shown { opacity: 1; }
.fit-base__name { font-size: 10.5px; -unity-font-style: bold; color: #e6e6e6; max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fit-base__version { margin-left: 5px; font-size: 10px; color: #00DA6D; }

.fit-card__close {
    width: 22px;
    height: 22px;
    margin: 0 0 0 4px;
    padding: 5px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.1s;
}

.fit-card__close .orb-icon { width: 12px; height: 12px; --icon-color: #8c8c8c; }
.fit-card__close:hover { background-color: rgba(255, 255, 255, 0.08); }
.fit-card__close:hover .orb-icon { --icon-color: #e6e6e6; }
.fit-card__close.fit-pressed { scale: 0.88 0.88; }

.fit-card__detail {
    margin: 6px 0 0 38px;
    font-size: 11px;
    color: #a6a6a6;
    white-space: normal;
}

/* The blendshapes it would get. */
.fit-card__chips { flex-direction: row; flex-wrap: wrap; margin: 8px 0 0 38px; }

.fit-chip {
    margin: 0 4px 4px 0;
    padding: 2px 9px;
    border-radius: 10px;
    background-color: rgba(0, 218, 109, 0.12);
    font-size: 10.5px;
    -unity-font-style: bold;
    color: #00DA6D;
}

.fit-chip--more { color: #a6a6a6; background-color: rgba(255, 255, 255, 0.06); }

/* The two answers of the question. */
.fit-card__tiles { flex-direction: row; margin-top: 10px; }

.fit-tile {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 58px;
    margin: 0;
    padding: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 12px;
    background-color: #2a2a2a;
    background-image: none;
    translate: 0 0;
    scale: 1 1;
    transition-property: background-color, translate, scale;
    transition-duration: 0.16s, 0.2s, 0.1s;
    transition-timing-function: ease-out, ease-out-back, ease-out;
}

.fit-tile--yes { margin-right: 6px; }
.fit-tile:hover { background-color: #333333; translate: 0 -1px; }
.fit-tile.fit-pressed { scale: 0.94 0.94; translate: 0 0; }
.fit-tile:disabled { opacity: 0.5; }

.fit-tile__icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 9px;
    align-items: center;
    justify-content: center;
}

.fit-tile__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.fit-tile__title { font-size: 12px; -unity-font-style: bold; color: #f2f2f2; -unity-text-align: middle-left; white-space: normal; }
.fit-tile__subtitle { margin-top: 2px; font-size: 10.5px; color: #9a9a9a; -unity-text-align: middle-left; white-space: normal; }

/* Buttons. */
.fit-card__actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 10px 0 0 38px; }

.fit-btn {
    height: 28px;
    margin: 0 6px 0 0;
    padding: 0 14px;
    border-width: 0;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    background-image: none;
    color: #d9d9d9;
    font-size: 11.5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: background-color, color, scale;
    transition-duration: 0.14s, 0.14s, 0.2s;
    transition-timing-function: ease-out, ease-out, ease-out-back;
}

.fit-btn:hover { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
.fit-btn.fit-pressed { scale: 0.94 0.94; }
.fit-btn:disabled { opacity: 0.45; }
.fit-btn--primary { background-color: #00DA6D; color: #06140c; }
.fit-btn--primary:hover { background-color: #19e27d; color: #06140c; }
.fit-btn--ghost { background-color: #3a3a3a; color: #d9d9d9; }
.fit-btn--ghost:hover { background-color: #4a4a4a; color: #ffffff; }
.fit-btn--small { height: 22px; padding: 0 10px; font-size: 10.5px; margin: 0 0 0 8px; flex-shrink: 0; }

.fit-card__callout {
    margin: 8px 0 0 38px;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: rgba(255, 176, 32, 0.1);
}

.fit-card__callout-text { font-size: 10.5px; color: #ffd48a; white-space: normal; }

/* Lining up with the original body. */
.fit-step { margin: 8px 0 0 0; }
.fit-step__line { flex-direction: row; align-items: center; }

.fit-step__number {
    width: 20px;
    height: 20px;
    margin: 0 10px 0 4px;
    flex-shrink: 0;
    border-radius: 10px;
    background-color: rgba(0, 218, 109, 0.14);
    color: #00DA6D;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.fit-step__text { flex-grow: 1; flex-shrink: 1; font-size: 11px; color: #cfcfcf; white-space: normal; }
.fit-card__tightness { margin: 6px 0 0 34px; }

/* A refit at work. */
.fit-card__track {
    height: 6px;
    margin: 12px 0 0 38px;
    border-radius: 3px;
    overflow: hidden;
    background-color: #2e2e2e;
}

.fit-card__fill {
    height: 100%;
    width: 0;
    border-radius: 3px;
    overflow: hidden;
    background-color: #00DA6D;
    transition-property: width;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.fit-card__shimmer {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    left: -60px;
    background-color: rgba(255, 255, 255, 0.22);
}

.fit-card__progress { margin: 6px 0 0 38px; font-size: 10.5px; color: #9a9a9a; white-space: normal; }

/* The accessory's fit in its list row. */
.fit-status {
    margin-left: 6px;
    padding: 1px 7px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.fit-status--fitted { color: #00DA6D; background-color: rgba(0, 218, 109, 0.12); }
.fit-status--question { color: #ffb020; background-color: rgba(255, 176, 32, 0.12); }
.fit-status--working { color: #00DA6D; background-color: rgba(0, 218, 109, 0.12); }
