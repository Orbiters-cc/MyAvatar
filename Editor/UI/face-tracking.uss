/* Face tracking: the live test stage, the phone link and what VRChat receives when testing, then the hero frame with the quick settings fold.
   Same palette and radii as the photoshoot and thumbnail studio: 16 px frames, 12 px rows, #00DA6D accent. */

.ft-hero { padding: 16px 16px 16px 14px; margin-bottom: 10px; border-radius: 16px; background-color: #1c1e23; border-width: 1px; border-color: rgba(255, 255, 255, 0.05); overflow: hidden; }
.ft-hero__top { flex-direction: row; align-items: center; }
.ft-hero--settings-only { padding-top: 4px; padding-bottom: 6px; }
.ft-hero--settings-only .ft-fold { margin-top: 0; border-top-width: 0; }
.ft-hero__badge { width: 78px; height: 78px; flex-shrink: 0; margin-right: 16px; }
.ft-hero__glow { position: absolute; left: -22px; top: -22px; width: 122px; height: 122px; }
.ft-hero__ring { width: 78px; height: 78px; }
.ft-hero__logo { position: absolute; left: 19px; top: 19px; width: 40px; height: 40px; }
.ft-hero__title-row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.ft-hero__version { height: 18px; margin: 3px 0 0 8px; padding: 0 7px; border-radius: 9px; background-color: rgba(255, 255, 255, 0.07); color: #a8a8a8; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ft-hero__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ft-hero__eyebrow { margin: 0; padding: 0; font-size: 10px; letter-spacing: 1px; color: #00DA6D; -unity-font-style: bold; }
.ft-hero__eyebrow.warning { color: #ffb020; }
.ft-hero__eyebrow.muted { color: #8f8f8f; }
.ft-hero__title { margin: 3px 0 0 0; padding: 0; font-size: 15px; color: #ffffff; -unity-font-style: bold; white-space: normal; }
.ft-hero__subtitle { margin: 3px 0 0 0; padding: 0; font-size: 11px; color: #9a9a9a; white-space: normal; }
.ft-hero__actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 10px; }

.mcb-button.ft-primary { height: 34px; min-height: 34px; margin: 0 8px 0 0; padding: 0 18px; border-radius: 17px; background-color: #00DA6D; color: #06140c; -unity-font-style: bold; font-size: 12px; transition-property: background-color, scale; transition-duration: 0.14s, 0.2s; transition-timing-function: ease-out, ease-out-back; }
.mcb-button.ft-primary:hover { background-color: #19e27d; }
.mcb-button.ft-ghost { height: 28px; min-height: 28px; margin: 0 6px 0 0; padding: 0 12px; border-radius: 14px; background-color: rgba(255, 255, 255, 0.06); color: #d9d9d9; font-size: 11px; -unity-font-style: normal; }
.mcb-button.ft-ghost:hover { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
.mcb-button.ft-primary.pressed, .mcb-button.ft-ghost.pressed { scale: 0.95 0.95; }

/* ---- Live stage --------------------------------------------------------------------------------- */
.ft-stage { position: relative; height: 300px; margin-bottom: 10px; border-radius: 16px; overflow: hidden; background-color: #0e1015; border-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.ft-stage__image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ft-tag { position: absolute; flex-direction: row; align-items: center; height: 22px; padding: 0 10px; border-radius: 11px; background-color: rgba(10, 12, 16, 0.72); }
.ft-tag--status { left: 12px; top: 12px; }
.ft-tag--rate { right: 12px; top: 12px; }
.ft-tag__text { margin: 0; padding: 0; font-size: 10px; color: #f2f2f2; -unity-font-style: bold; letter-spacing: 0.5px; }
.ft-dot { width: 7px; height: 7px; flex-shrink: 0; margin-right: 6px; border-radius: 4px; background-color: #ffb020; transition-property: opacity; transition-duration: 0.5s; }
.ft-dot--live { background-color: #00DA6D; }
.ft-dot--sim { background-color: #8a7dff; }
.ft-dot--error { background-color: #ff6b5e; }
.ft-dot--dim { opacity: 0.25; }
.ft-stage__hint { position: absolute; left: 0; right: 0; bottom: 14px; margin: 0; padding: 0; -unity-text-align: middle-center; font-size: 10px; color: rgba(255, 255, 255, 0.4); }
.mcb-button.ft-stage__stop { position: absolute; right: 12px; bottom: 10px; height: 26px; min-height: 26px; margin: 0; padding: 0 12px; border-radius: 13px; background-color: rgba(10, 12, 16, 0.72); color: #e6e6e6; font-size: 11px; }
.mcb-button.ft-stage__stop:hover { background-color: rgba(40, 42, 48, 0.9); }
.ft-stage__notice { position: absolute; left: 12px; bottom: 10px; flex-direction: row; align-items: center; height: 26px; padding: 0 4px 0 10px; border-radius: 13px; background-color: rgba(10, 12, 16, 0.72); }
.ft-stage__notice-text { margin: 0 6px 0 0; padding: 0; font-size: 10px; color: #ffb020; }
.mcb-button.ft-stage__notice-button { height: 20px; min-height: 20px; margin: 0; padding: 0 8px; border-radius: 10px; background-color: rgba(255, 176, 32, 0.16); color: #ffcf73; font-size: 10px; -unity-font-style: bold; }

.ft-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(14, 16, 21, 0.5); }
.ft-overlay--solid { background-color: #0e1015; }
.ft-overlay__pulse { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ft-overlay__card { width: 76%; max-width: 380px; padding: 16px 18px; border-radius: 14px; background-color: rgba(30, 32, 38, 0.94); }
.ft-overlay__title { margin: 0; padding: 0; font-size: 13px; color: #ffffff; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.ft-overlay__text { margin: 5px 0 0 0; padding: 0; font-size: 11px; color: #a0a0a0; -unity-text-align: middle-center; white-space: normal; }
.ft-overlay__text.warning { color: #ff8c59; }
.ft-overlay__actions { flex-direction: row; justify-content: center; margin-top: 12px; }
.ft-progress { height: 8px; margin-top: 12px; border-radius: 4px; background-color: #2e2e2e; overflow: hidden; }
.ft-progress__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 4px; background-color: #00DA6D; transition-property: width; transition-duration: 0.35s; transition-timing-function: ease-out; }
.ft-progress__shimmer { position: absolute; top: 0; bottom: 0; width: 30%; border-radius: 4px; background-color: rgba(255, 255, 255, 0.16); }

/* ---- Link with the phone ------------------------------------------------------------------------- */
.ft-card { margin-bottom: 10px; padding: 12px 14px 14px 14px; border-radius: 16px; background-color: #242424; border-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.ft-card__header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.ft-card__title { margin: 0; padding: 0; color: #f2f2f2; font-size: 12px; -unity-font-style: bold; }
.ft-card__aside { margin: 0; padding: 0; color: #8f8f8f; font-size: 11px; }
.ft-address { flex-direction: row; align-items: center; margin: 12px 0 2px 0; padding: 8px 8px 8px 14px; border-radius: 12px; background-color: #1a1a1a; }
.ft-address__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ft-address__label { margin: 0; padding: 0; font-size: 10px; color: #8f8f8f; letter-spacing: 0.6px; -unity-font-style: bold; }
.ft-address__value { margin: 1px 0 0 0; padding: 0; font-size: 19px; color: #ffffff; -unity-font-style: bold; }
.ft-address__port { margin: 0 0 0 6px; padding: 0; font-size: 12px; color: #8f8f8f; }
.ft-address__others { margin: 2px 0 0 0; padding: 0; font-size: 10px; color: #6f6f6f; white-space: normal; }
.mcb-button.ft-copy { height: 26px; min-height: 26px; margin: 0 0 0 6px; padding: 0 12px; border-radius: 13px; background-color: #333333; color: #e6e6e6; font-size: 11px; flex-shrink: 0; }
.mcb-button.ft-copy:hover { background-color: #3d3d3d; }
.mcb-button.ft-copy--done { background-color: rgba(0, 218, 109, 0.16); color: #00DA6D; }
.ft-steps { margin-top: 10px; }
.ft-step { flex-direction: row; align-items: flex-start; margin-top: 7px; }
.ft-step__number { width: 18px; height: 18px; flex-shrink: 0; margin: 0 8px 0 0; padding: 0; border-radius: 9px; background-color: rgba(0, 218, 109, 0.14); color: #00DA6D; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ft-step__body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ft-step__text { margin: 1px 0 0 0; padding: 0; font-size: 11px; color: #d0d0d0; white-space: normal; }
.ft-phone { flex-direction: row; align-items: center; margin-top: 6px; }
.ft-phone__field { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 6px 0 0; }
.ft-phone__field > .unity-text-field__input { min-height: 28px; padding: 0 10px; border-radius: 14px; border-width: 1px; border-color: #333333; background-color: #1a1a1a; font-size: 12px; color: #ffffff; }
.ft-phone__field.invalid > .unity-text-field__input { border-color: #ff6b5e; }
.ft-status { flex-direction: row; align-items: center; margin-top: 12px; padding: 8px 10px; border-radius: 12px; background-color: #1d1d1d; }
.ft-status__text { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; font-size: 11px; color: #d6d6d6; white-space: normal; }
.ft-hint { margin-top: 8px; padding: 8px 10px; border-radius: 12px; background-color: rgba(255, 176, 32, 0.08); color: #e8c27a; font-size: 11px; white-space: normal; }

/* ---- What VRChat receives ------------------------------------------------------------------------ */
.ft-meters { flex-direction: row; flex-wrap: wrap; margin: 0 -8px; }
.ft-meters__group { width: 50%; padding: 0 8px; margin-bottom: 8px; }
.ft-meters__title { margin: 0 0 4px 0; padding: 0; font-size: 10px; color: #8f8f8f; letter-spacing: 0.6px; -unity-font-style: bold; }
.ft-meter { flex-direction: row; align-items: center; height: 17px; }
.ft-meter__label { width: 62px; flex-shrink: 0; margin: 0; padding: 0; font-size: 10px; color: #bdbdbd; }
.ft-meter__track { flex-grow: 1; height: 6px; border-radius: 3px; background-color: #1a1a1a; overflow: hidden; }
.ft-meter__fill { position: absolute; top: 0; bottom: 0; left: 0; width: 0; border-radius: 3px; background-color: #00DA6D; }
.ft-meter__fill--negative { background-color: #8a7dff; }
.ft-meter__zero { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background-color: rgba(255, 255, 255, 0.18); }
.ft-meter__value { width: 34px; flex-shrink: 0; margin: 0 0 0 6px; padding: 0; font-size: 10px; color: #8f8f8f; -unity-text-align: middle-right; }
.ft-meter--off { opacity: 0.32; }

/* ---- Quick settings ------------------------------------------------------------------------------ */
.ft-setting { margin-top: 14px; }
.ft-setting--first { margin-top: 0; }
.ft-setting__header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 7px; }
.ft-setting__title { margin: 0; padding: 0; color: #f2f2f2; font-size: 12px; -unity-font-style: bold; }
.ft-setting__aside { margin: 0; padding: 0; color: #8f8f8f; font-size: 11px; }
.ft-setting__caption { margin: 6px 0 0 2px; padding: 0; color: #8f8f8f; font-size: 11px; white-space: normal; }
.ft-presets { flex-direction: row; flex-wrap: wrap; }
.mcb-button.ft-preset { height: 24px; min-height: 24px; margin: 0 0 0 4px; padding: 0 10px; border-radius: 12px; background-color: #303030; color: #cfcfcf; font-size: 11px; -unity-font-style: normal; }
.mcb-button.ft-preset:hover { background-color: #3a3a3a; color: #ffffff; }
.mcb-button.ft-preset--on, .mcb-button.ft-preset--on:hover { background-color: rgba(0, 218, 109, 0.16); color: #ffffff; }
.ft-feature { flex-direction: row; align-items: center; min-height: 36px; margin-top: 4px; padding: 5px 8px 5px 12px; border-radius: 12px; background-color: #2a2a2a; }
.ft-feature--child { margin-left: 16px; background-color: #272727; }
.ft-feature:disabled { opacity: 0.4; }
.ft-feature__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.ft-feature__name { margin: 0; padding: 0; font-size: 12px; color: #ffffff; -unity-font-style: bold; }
.ft-feature__detail { margin: 1px 0 0 0; padding: 0; font-size: 10px; color: #8f8f8f; white-space: normal; }
.ft-bits { height: 18px; flex-shrink: 0; margin: 0 10px 0 0; padding: 0 7px; border-radius: 9px; background-color: rgba(138, 125, 255, 0.14); color: #b9b1ff; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; }
.ft-bits--off { background-color: rgba(255, 255, 255, 0.05); color: #6f6f6f; }
.ft-budget { margin-top: 10px; padding: 10px 12px; border-radius: 12px; background-color: #1d1d1d; }
.ft-budget__text { margin: 8px 0 0 0; padding: 0; font-size: 11px; color: #9a9a9a; white-space: normal; }
.ft-budget__text.warning { color: #ffb020; }
.ft-switch-row { flex-direction: row; align-items: center; padding: 8px 8px 8px 12px; border-radius: 12px; background-color: #2a2a2a; }
.ft-switch-row__text { flex-grow: 1; flex-shrink: 1; margin-right: 10px; }

/* ---- The quick settings fold, in the hero frame --------------------------------------------------- */
.ft-fold { margin-top: 14px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.06); }
.ft-fold__header { flex-direction: row; align-items: center; height: 34px; margin: 0 -6px; padding: 0 6px; border-radius: 10px; cursor: link; }
.ft-fold__header:hover { background-color: rgba(255, 255, 255, 0.04); }
.ft-fold__chevron { width: 14px; height: 14px; margin-right: 6px; --icon-color: #9a9a9a; transition-property: rotate; transition-duration: 0.15s; }
.ft-fold__chevron--open { rotate: 90deg; }
.ft-fold__title { flex-grow: 1; margin: 0; padding: 0; color: #f2f2f2; font-size: 12px; -unity-font-style: bold; }
.ft-fold__summary { margin: 0; padding: 0; color: #8f8f8f; font-size: 11px; }
.ft-fold__body { padding-top: 6px; }

.ft-trackers { flex-direction: row; flex-wrap: wrap; margin: 0 -3px; }
.mcb-button.ft-tracker { flex-grow: 1; flex-basis: 22%; min-width: 86px; height: 92px; min-height: 92px; margin: 3px; padding: 10px 6px 8px 6px; border-width: 0; border-radius: 14px; background-color: #26282e; align-items: center; justify-content: center; transition-property: background-color, scale; transition-duration: 0.14s, 0.2s; transition-timing-function: ease-out, ease-out-back; }
.mcb-button.ft-tracker:hover { background-color: #2e3038; }
.mcb-button.ft-tracker.pressed { scale: 0.96 0.96; }
.mcb-button.ft-tracker--on, .mcb-button.ft-tracker--on:hover { background-color: rgba(0, 218, 109, 0.16); }
.ft-tracker__logo { width: 30px; height: 30px; margin-bottom: 8px; opacity: 0.6; transition-property: opacity; transition-duration: 0.14s; }
.ft-tracker:hover .ft-tracker__logo, .ft-logo--on { opacity: 1; }
.ft-logo__mark { flex-grow: 1; --icon-color: #ffffff; }
.ft-tracker__name { margin: 0; padding: 0; font-size: 12px; color: #d9d9d9; -unity-font-style: bold; -unity-text-align: middle-center; }
.ft-tracker__sub { margin: 1px 0 0 0; padding: 0; font-size: 10px; color: #7f7f7f; -unity-text-align: middle-center; }
.ft-tracker--on .ft-tracker__name { color: #ffffff; }
.ft-tracker--on .ft-tracker__sub { color: #9ad9b8; }
.ft-trackers__caption { margin: 8px 2px 0 2px; padding: 0; color: #8f8f8f; font-size: 11px; white-space: normal; }
.ft-trackers__caption.warning { color: #ffb020; }
.ft-custom { margin-top: 12px; padding: 12px; border-radius: 14px; background-color: #23252b; }

.ft-note { margin-top: 8px; color: #8f8f8f; font-size: 11px; white-space: normal; }
.ft-note.warning { color: #ffb020; }
.ft-credit { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 4px; }
.ft-credit .avatar-caption { margin-top: 0; }
.mcb-button.avatar-link.ft-credit__link { padding: 0 4px; margin-left: 2px; color: #b8b8b8; }
