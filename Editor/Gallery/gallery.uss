/* My Avatar asset gallery. Same language as the rest of the window: 16 px frames, 12 px rows, flat surfaces, green
   primary, purple for Orbiters' own highlights, amber for questions and warnings. */

/* ---- Entry card on the main page ---- */
.gallery-hero { height: 118px; margin: 4px 0 14px 0; border-radius: 16px; overflow: hidden; background-color: #14111d; cursor: link;
    transition-property: translate, scale; transition-duration: 0.22s; transition-timing-function: ease-out-back; }
.gallery-hero:hover { translate: 0 -2px; }
.gallery-hero--pressed { scale: 0.985 0.985; }
.gallery-hero__glow { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.gallery-hero__content { flex-direction: row; align-items: center; flex-grow: 1; padding: 0 18px 0 20px; }
.gallery-hero__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.gallery-hero__eyebrow { margin: 0; padding: 0; font-size: 10px; letter-spacing: 1.4px; -unity-font-style: bold; color: #b9b1ff; }
.gallery-hero__title { margin: 3px 0 0 0; padding: 0; font-size: 19px; -unity-font-style: bold; color: #ffffff; }
.gallery-hero__subtitle { margin: 4px 0 0 0; padding: 0; font-size: 11px; color: #c9c4e6; white-space: normal; }
.gallery-hero__fan { width: 150px; height: 96px; flex-shrink: 0; margin-left: 8px; }
.gallery-hero__tile { position: absolute; width: 66px; height: 66px; top: 15px; border-radius: 14px; overflow: hidden; background-color: #2a2540;
    border-width: 2px; border-color: rgba(255, 255, 255, 0.12); transition-property: rotate, translate, opacity; transition-duration: 0.35s;
    transition-timing-function: ease-out-back; opacity: 0.0; }
.gallery-hero__tile.gallery-image--shown, .gallery-hero__tile--placeholder { opacity: 1; }
.gallery-hero__tile--0 { left: 2px; rotate: -12deg; translate: 0 6px; }
.gallery-hero__tile--1 { left: 42px; rotate: 0deg; translate: 0 -4px; }
.gallery-hero__tile--2 { left: 82px; rotate: 12deg; translate: 0 6px; }
.gallery-hero:hover .gallery-hero__tile--0 { rotate: -18deg; translate: -6px 8px; }
.gallery-hero:hover .gallery-hero__tile--1 { translate: 0 -8px; }
.gallery-hero:hover .gallery-hero__tile--2 { rotate: 18deg; translate: 6px 8px; }
.gallery-hero__chevron { width: 14px; height: 14px; flex-shrink: 0; margin-left: 6px; --icon-color: #d8d2ff; }

/* ---- Page ---- */
.gallery-page { flex-grow: 1; }
.gallery-page__header { flex-direction: row; align-items: center; margin: 0 0 12px 0; }
.gallery-back { width: 30px; height: 30px; min-width: 30px; margin: 0 10px 0 -4px; padding: 0; border-width: 0; border-radius: 15px;
    background-color: #262626; align-items: center; justify-content: center; transition-property: background-color, scale; transition-duration: 0.12s; }
.gallery-back:hover { background-color: #333333; }
.gallery-back:active { scale: 0.92 0.92; }
.gallery-back__icon { width: 14px; height: 14px; rotate: 180deg; --icon-color: #e6e6e6; }
.gallery-page__title { flex-grow: 1; margin: 0; padding: 0; font-size: 16px; -unity-font-style: bold; color: #ffffff; }
.gallery-page__header .mcb-button { height: 28px; min-height: 28px; margin: 0 0 0 6px; padding: 0 12px; border-radius: 14px; font-size: 11px; }
.gallery-publish { background-color: #8a7dff; -unity-font-style: bold; }
.gallery-publish:hover { background-color: #9b90ff; }

.gallery-context { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }
.gallery-pill { flex-direction: row; align-items: center; height: 24px; margin: 0 6px 6px 0; padding: 0 10px; border-radius: 12px; background-color: #1f1f1f; }
.gallery-pill__label { margin: 0; padding: 0; font-size: 11px; color: #d6d6d6; }
.gallery-pill__value { margin: 0 0 0 4px; padding: 0; font-size: 11px; -unity-font-style: bold; color: #ffffff; }
.gallery-pill--action { cursor: link; }
.gallery-pill--action:hover { background-color: #2a2a2a; }
.gallery-pill--warning .gallery-pill__value { color: #ffb020; }
.gallery-pill__dot { width: 6px; height: 6px; border-radius: 3px; margin-right: 6px; background-color: #00DA6D; }
.gallery-pill--warning .gallery-pill__dot { background-color: #ffb020; }

.gallery-toolbar { flex-direction: row; align-items: center; margin: 4px 0 12px 0; }
.gallery-search { flex-grow: 1; flex-shrink: 1; min-width: 80px; margin: 0 8px 0 0; }
.gallery-search > .unity-text-field__input, .gallery-search .unity-base-text-field__input { min-height: 30px; padding: 0 12px; border-radius: 15px; border-width: 0; background-color: #1f1f1f; color: #ffffff; }
.gallery-search__hint { position: absolute; left: 13px; top: 8px; font-size: 11px; color: #707070; }
.gallery-filters { flex-shrink: 0; }

.gallery-grid { margin: 0 -6px; }
.gallery-empty { margin: 18px 0; padding: 26px 16px; border-radius: 16px; background-color: #1c1c1c; align-items: center; }
.gallery-empty__title { margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: #f2f2f2; white-space: normal; -unity-text-align: middle-center; }
.gallery-empty__text { margin: 6px 0 0 0; padding: 0; font-size: 11px; color: #9a9a9a; white-space: normal; -unity-text-align: middle-center; }
.gallery-empty .mcb-button { margin-top: 12px; height: 28px; min-height: 28px; border-radius: 14px; padding: 0 14px; }
.gallery-footer { flex-direction: row; justify-content: space-between; align-items: center; margin: 6px 0 4px 0; }
.gallery-link { height: 22px; min-height: 22px; margin: 0; padding: 0 8px; border-width: 0; border-radius: 11px; background-color: rgba(0, 0, 0, 0); color: #9a9a9a; font-size: 11px; }
.gallery-link:hover { background-color: rgba(255, 255, 255, 0.08); color: #e6e6e6; }
.gallery-link--danger, .gallery-link--danger:hover { background-color: rgba(255, 90, 90, 0.14); color: #ff8a8a; }

/* ---- Cards (on top of Toolkit's gallery-card.uss) ---- */
.gallery-card { height: auto; margin-bottom: 12px; background-color: #1b1b1b; border-radius: 16px; transition-property: background-color, translate; transition-duration: 0.15s; }
.gallery-card:hover { background-color: #222222; translate: 0 -1px; }
.gallery-card .orb-card__media { border-top-left-radius: 16px; border-top-right-radius: 16px; background-color: #141414; }
.gallery-card__image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; transition-property: opacity, scale; transition-duration: 0.35s; }
.gallery-card__image.gallery-image--shown { opacity: 1; }
.gallery-card:hover .gallery-card__image { scale: 1.04 1.04; }
.gallery-card__shimmer { position: absolute; top: 0; bottom: 0; width: 40%; background-color: rgba(255, 255, 255, 0.035); }
.gallery-card__chips { position: absolute; left: 8px; top: 8px; right: 8px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.gallery-chip { height: 20px; margin: 0; padding: 0 8px; border-radius: 10px; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: #ffffff; background-color: rgba(12, 12, 14, 0.78); }
.gallery-chip--free, .gallery-chip--owned { color: #06140c; background-color: #00DA6D; }
.gallery-chip--included { color: #ffffff; background-color: #8a7dff; }
.gallery-chip--warning { color: #1a1205; background-color: #ffb020; }
.gallery-chip--muted { color: #d6d6d6; background-color: rgba(12, 12, 14, 0.78); }
.gallery-card__body { padding: 10px 11px 11px 11px; flex-grow: 0; }
.gallery-card__title { margin: 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: #ffffff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-creator { flex-direction: row; align-items: center; margin-top: 5px; height: 16px; }
.gallery-creator__avatar { width: 16px; height: 16px; border-radius: 8px; overflow: hidden; background-color: #333333; margin-right: 5px; flex-shrink: 0; }
.gallery-creator__name { margin: 0; padding: 0; font-size: 10px; color: #bdbdbd; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.gallery-creator__trusted { width: 11px; height: 11px; margin-left: 4px; flex-shrink: 0; --icon-color: #00DA6D; }
.gallery-card__meta { margin: 6px 0 0 0; padding: 0; font-size: 10px; color: #7f7f7f; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-card__actions { flex-direction: row; margin-top: 9px; }
.gallery-card__actions .mcb-button { height: 26px; min-height: 26px; margin: 0; padding: 0 8px; border-radius: 13px; font-size: 11px; flex-basis: 0; }
.gallery-card__info { flex-grow: 1; margin-right: 6px; background-color: #2c2c2c; }
.gallery-card__info:hover { background-color: #383838; }
.gallery-card__primary { flex-grow: 1.4; }
.gallery-btn--add { background-color: #00DA6D; color: #06140c; -unity-font-style: bold; }
.gallery-btn--add:hover { background-color: #19e27d; }
.gallery-btn--buy { background-color: #8a7dff; color: #ffffff; -unity-font-style: bold; }
.gallery-btn--buy:hover { background-color: #9b90ff; }
.gallery-btn--installed { background-color: rgba(0, 218, 109, 0.12); color: #00DA6D; -unity-font-style: bold; }
.gallery-btn--installed:hover { background-color: rgba(255, 107, 107, 0.16); color: #ff8a8a; }
.gallery-btn--question { background-color: #ffb020; color: #1a1205; -unity-font-style: bold; }
.gallery-btn--question:hover { background-color: #ffc04d; }
.gallery-btn--off { background-color: #262626; color: #8c8c8c; }

/* Install progress: the primary button turns into a bar. */
.gallery-progress { flex-grow: 1.4; height: 26px; border-radius: 13px; background-color: #2a2a2a; overflow: hidden; justify-content: center; flex-basis: 0; }
.gallery-progress__fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 13px; background-color: #00DA6D; transition-property: width; transition-duration: 0.3s; }
.gallery-progress__label { margin: 0; padding: 0 8px; font-size: 10px; -unity-font-style: bold; color: #ffffff; -unity-text-align: middle-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-card__status { margin: 6px 0 0 0; padding: 0; font-size: 10px; color: #9a9a9a; white-space: normal; }
.gallery-card__status.warning { color: #ffb020; }
.gallery-card__status.error { color: #ff7a7a; }
.gallery-card--done .orb-card__media { border-bottom-width: 2px; border-color: #00DA6D; }
.gallery-pop { scale: 1.06 1.06; }

/* "Publish an asset" card for creators */
.gallery-create { background-color: #17151f; border-width: 1px; border-color: rgba(138, 125, 255, 0.25); }
.gallery-create:hover { background-color: #1e1b2b; }
.gallery-create__plus { font-size: 40px; color: #b9b1ff; -unity-font-style: bold; -unity-text-align: middle-center; margin: 0; }
.gallery-create__label { margin: 0; padding: 0 10px; font-size: 12px; -unity-font-style: bold; color: #ffffff; white-space: normal; -unity-text-align: middle-center; }
.gallery-create__hint { margin: 4px 0 0 0; padding: 0 12px; font-size: 10px; color: #9a94bd; white-space: normal; -unity-text-align: middle-center; }

/* ---- License key bar (like /assets on the website) ---- */
.license-bar { flex-direction: row; align-items: center; margin-bottom: 10px; min-height: 32px; }
.license-bar__open { height: 30px; min-height: 30px; margin: 0; padding: 0 14px 0 10px; border-radius: 15px; border-width: 0; background-color: #1f1f1f;
    flex-direction: row; align-items: center; color: #e6e6e6; font-size: 11px; transition-property: background-color, width; transition-duration: 0.2s; }
.license-bar__open:hover { background-color: #2a2a2a; }
.license-bar__icon { width: 14px; height: 14px; margin-right: 6px; --icon-color: #00DA6D; }
.license-feedback { margin: -4px 0 10px 4px; padding: 0; font-size: 11px; white-space: normal; color: #00DA6D; }
.license-feedback.error { color: #ff7a7a; }

/* ---- Sheets: confirmation, purchase and details open over the gallery ---- */
/* The host covers the page (padding included) and never reaches past its sides: no horizontal scrolling. */
.gallery-sheet-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
/* Drawn in code (GalleryScrim): solid below, fading out over its first 80 px, which overlap the tool's header. */
.gallery-scrim { position: absolute; left: 0; top: -80px; right: 0; bottom: 0; opacity: 0; transition-property: opacity; transition-duration: 0.22s; }
.gallery-scrim--shown { opacity: 1; }
.gallery-sheet { position: absolute; border-radius: 16px; background-color: #1d1d1d; overflow: hidden; opacity: 0.4;
    transition-property: left, top, width, height, opacity; transition-duration: 0.32s; transition-timing-function: ease-out-back; }
.gallery-sheet--open { opacity: 1; }
.gallery-sheet--closing { transition-timing-function: ease-in; transition-duration: 0.2s; opacity: 0.2; }
.gallery-sheet__scroll { flex-grow: 1; }
.gallery-sheet__content { padding: 18px 18px 16px 18px; }
.gallery-sheet__eyebrow { margin: 0; padding: 0; font-size: 10px; letter-spacing: 1.2px; -unity-font-style: bold; color: #ffb020; }
.gallery-sheet__title { margin: 4px 0 0 0; padding: 0; font-size: 15px; -unity-font-style: bold; color: #ffffff; white-space: normal; }
.gallery-sheet__text { margin: 6px 0 0 0; padding: 0; font-size: 11px; color: #c4c4c4; white-space: normal; }
.gallery-sheet__list { margin-top: 10px; padding: 8px 10px; border-radius: 12px; background-color: #151515; }
.gallery-sheet__line { margin: 1px 0; padding: 0; font-size: 10px; color: #b5b5b5; white-space: normal; }
.gallery-sheet__actions { flex-direction: row; justify-content: flex-end; margin-top: 14px; }
.gallery-sheet__actions .mcb-button { height: 30px; min-height: 30px; margin: 0 0 0 8px; padding: 0 14px; border-radius: 15px; font-size: 11px; }
.gallery-sheet__close { position: absolute; top: 10px; right: 10px; width: 28px; height: 28px; min-width: 28px; padding: 0; margin: 0; border-width: 0; border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.45); align-items: center; justify-content: center; }
.gallery-sheet__close:hover { background-color: rgba(255, 255, 255, 0.12); }
.gallery-sheet__close-icon { width: 10px; height: 10px; --icon-color: #e6e6e6; }

/* Purchase */
.buy-store { flex-direction: row; align-items: center; min-height: 44px; margin-top: 6px; padding: 0 12px; border-radius: 12px; background-color: #262626; cursor: link;
    transition-property: background-color, scale; transition-duration: 0.12s; }
.buy-store:hover { background-color: #303030; }
.buy-store--pressed { scale: 0.98 0.98; }
.buy-store--preferred { background-color: rgba(138, 125, 255, 0.16); border-width: 1px; border-color: rgba(138, 125, 255, 0.45); }
.buy-store--preferred:hover { background-color: rgba(138, 125, 255, 0.24); }
.buy-store__tile { width: 26px; height: 26px; border-radius: 8px; margin-right: 10px; background-color: #3a3a3a; -unity-text-align: middle-center; font-size: 12px; -unity-font-style: bold; color: #ffffff; flex-shrink: 0; }
.buy-store__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.buy-store__name { margin: 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: #ffffff; }
.buy-store__note { margin: 1px 0 0 0; padding: 0; font-size: 10px; color: #b9b1ff; white-space: normal; }
.buy-store__open { width: 12px; height: 12px; --icon-color: #9a9a9a; }
.buy-wait { flex-direction: row; align-items: center; margin-top: 12px; padding: 10px 12px; border-radius: 12px; background-color: rgba(0, 218, 109, 0.08); }
.buy-wait__spinner { width: 14px; height: 14px; margin-right: 10px; border-radius: 7px; border-width: 2px; border-color: rgba(0, 218, 109, 0.25); border-top-color: #00DA6D; flex-shrink: 0; }
.buy-wait__text { margin: 0; padding: 0; font-size: 11px; color: #d6f5e6; white-space: normal; flex-shrink: 1; }

/* Details */
.detail-hero { height: 220px; background-color: #141414; overflow: hidden; }
.detail-hero__image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; transition-property: opacity; transition-duration: 0.35s; }
.detail-hero__image.gallery-image--shown { opacity: 1; }
.detail-hero__fade { position: absolute; left: 0; right: 0; bottom: 0; height: 70px; background-color: rgba(29, 29, 29, 0.55); }
.detail-title-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.detail-title { margin: 0 8px 0 0; padding: 0; font-size: 17px; -unity-font-style: bold; color: #ffffff; white-space: normal; flex-shrink: 1; }
.detail-actions { flex-direction: row; margin-top: 12px; }
.detail-actions .mcb-button { height: 32px; min-height: 32px; margin: 0 8px 0 0; padding: 0 16px; border-radius: 16px; font-size: 12px; }
.detail-actions .gallery-progress { height: 32px; border-radius: 16px; flex-grow: 1; }
.detail-facts { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.detail-fact { width: 50%; margin-bottom: 8px; }
.detail-fact__label { margin: 0; padding: 0; font-size: 10px; color: #8a8a8a; }
.detail-fact__value { margin: 2px 0 0 0; padding: 0; font-size: 12px; color: #f2f2f2; white-space: normal; }
.detail-fact__value.warning { color: #ffb020; }
.detail-section { margin: 14px 0 6px 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: #ffffff; }
.detail-description { margin: 0; padding: 0; font-size: 11px; color: #c4c4c4; white-space: normal; }
.detail-setups { margin-top: 10px; }
.detail-dependency { flex-direction: row; align-items: center; min-height: 24px; padding: 0 10px; margin-bottom: 4px; border-radius: 10px; background-color: #242424; }
.detail-dependency__name { flex-grow: 1; margin: 0; padding: 0; font-size: 11px; color: #e6e6e6; }
.detail-dependency__state { margin: 0; padding: 0; font-size: 10px; color: #9a9a9a; }
.detail-dependency__state--ok { color: #00DA6D; }

/* ---- Installed on this avatar (accessories list) ---- */
.gallery-installed-chip { margin: 0 0 0 6px; padding: 1px 7px; border-radius: 9px; font-size: 10px; -unity-font-style: bold; color: #b9b1ff; background-color: rgba(138, 125, 255, 0.14); }
.gallery-installed-chip--update { color: #06140c; background-color: #00DA6D; }

/* ---- Creator page ---- */
.creator-intro { margin: 0 0 12px 0; padding: 0; font-size: 11px; color: #a8a8a8; white-space: normal; }
.creator-step { margin-bottom: 12px; padding: 14px 16px 16px 16px; border-radius: 16px; background-color: #1f1f1f; }
.creator-step--done { background-color: #1c1f1d; }
.creator-step__header { flex-direction: row; align-items: center; margin-bottom: 10px; }
.creator-step__number { width: 22px; height: 22px; border-radius: 11px; margin-right: 10px; background-color: #333333; color: #ffffff; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; flex-shrink: 0; }
.creator-step--done .creator-step__number { background-color: #00DA6D; color: #06140c; }
.creator-step__title { flex-grow: 1; margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: #ffffff; }
.creator-step__summary { margin: 0; padding: 0; font-size: 11px; color: #8f8f8f; }
.creator-label { margin: 8px 0 4px 2px; padding: 0; font-size: 11px; color: #bdbdbd; }
.creator-hint { margin: 4px 0 0 2px; padding: 0; font-size: 10px; color: #7f7f7f; white-space: normal; }
.creator-field { margin: 0; }
.creator-field > .unity-base-field__input, .creator-field .unity-text-field__input, .creator-field .unity-base-text-field__input { min-height: 26px; padding: 2px 10px; border-radius: 8px; border-width: 0; background-color: #2a2a2a; color: #ffffff; }
.creator-field--multiline .unity-text-field__input, .creator-field--multiline .unity-base-text-field__input { min-height: 64px; white-space: normal; -unity-text-align: upper-left; padding-top: 6px; }
.creator-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.creator-row > .creator-field { flex-grow: 1; flex-shrink: 1; min-width: 80px; margin-right: 8px; }
.creator-row--fields { flex-wrap: nowrap; }
.creator-row--fields > .creator-field { flex-basis: 0; }
.creator-row--fields > .creator-field--version { flex-grow: 0; flex-basis: 110px; }
.creator-asset { flex-direction: row; align-items: center; min-height: 34px; margin-top: 4px; padding: 0 10px; border-radius: 12px; background-color: #262626; cursor: link; }
.creator-asset:hover { background-color: #2e2e2e; }
.creator-asset--selected { background-color: rgba(0, 218, 109, 0.12); border-width: 1px; border-color: rgba(0, 218, 109, 0.45); }
.creator-asset__name { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; font-size: 12px; color: #f2f2f2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.creator-asset__meta { margin: 0 0 0 6px; padding: 0; font-size: 10px; color: #8f8f8f; flex-shrink: 0; }
.creator-chip { height: 24px; margin: 0 6px 6px 0; padding: 0 10px; border-radius: 12px; border-width: 0; background-color: #2a2a2a; color: #cfcfcf; font-size: 11px; }
.creator-chip:hover { background-color: #343434; }
.creator-chip--on { background-color: #00DA6D; color: #06140c; -unity-font-style: bold; }
.creator-chip--on:hover { background-color: #19e27d; }
.creator-chip--beta.creator-chip--on { background-color: #ffd84a; color: #1a1505; }
.creator-chip--alpha.creator-chip--on { background-color: #ff6b6b; color: #1a0505; }
.creator-variant { margin-top: 10px; padding: 12px 12px 12px 12px; border-radius: 12px; background-color: #262626; }
.creator-variant__header { flex-direction: row; align-items: center; }
.creator-variant__header > .creator-field { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-right: 6px; }
.creator-variant__header > .gallery-link { flex-shrink: 0; }
.creator-report { margin-top: 10px; padding: 10px 12px; border-radius: 10px; background-color: #1c1c1c; }
.creator-report__line { margin: 1px 0; padding: 0; font-size: 11px; color: #d0d0d0; white-space: normal; }
.creator-report__line--muted { color: #8a8a8a; font-size: 10px; }
.creator-report__line--warning { color: #ffb020; }
.creator-report__line--error { color: #ff7a7a; }
.creator-setup { margin-top: 8px; padding: 8px 10px; border-radius: 10px; background-color: #1f1f1f; }
.creator-prefab { flex-direction: row; align-items: center; min-height: 24px; }
.creator-prefab__toggle { margin: 0 6px 0 0; }
.creator-prefab__name { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; font-size: 11px; color: #e6e6e6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.creator-prefab__mode { width: 120px; margin: 0; }
.creator-actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 10px; }
.creator-actions .mcb-button { height: 28px; min-height: 28px; margin: 0 6px 0 0; padding: 0 12px; border-radius: 14px; font-size: 11px; }
.creator-rights { margin-top: 4px; }
.creator-rights .unity-toggle__input { flex-shrink: 1; align-items: flex-start; }
.creator-rights .unity-toggle__checkmark { flex-shrink: 0; margin-top: 1px; }
.creator-rights .unity-toggle__text { flex-shrink: 1; white-space: normal; margin-left: 6px; color: #e6e6e6; font-size: 11px; }
.creator-publish { height: 36px; min-height: 36px; margin-top: 12px; border-radius: 18px; }
.creator-message { margin-top: 8px; padding: 0; font-size: 11px; color: #00DA6D; white-space: normal; }
.creator-message.error { color: #ff7a7a; }
.creator-tester { flex-direction: row; align-items: center; min-height: 26px; margin-top: 4px; padding: 0 4px 0 10px; border-radius: 10px; background-color: #262626; }
.creator-tester__name { flex-grow: 1; margin: 0; padding: 0; font-size: 11px; color: #e6e6e6; }

/* Loading placeholders and the filter row */
.gallery-card--skeleton, .gallery-card--skeleton:hover { background-color: #1d1d1d; translate: 0 0; }
.gallery-card--skeleton .orb-card__media { background-color: #222222; }
.gallery-skeleton__bar { height: 10px; margin-top: 4px; border-radius: 5px; background-color: #2a2a2a; }
.gallery-skeleton__bar--small { height: 8px; margin-top: 8px; }
.gallery-skeleton__button { height: 26px; margin-top: 12px; border-radius: 13px; background-color: #262626; }
.gallery-card__shimmer { background-color: rgba(255, 255, 255, 0.025); width: 30%; }
.gallery-filters { margin: -4px 0 12px 0; }
.license-bar__label { margin: 0; padding: 0; font-size: 11px; color: #e6e6e6; }
.license-bar__open { justify-content: flex-start; }

/* License key form (the website's LicenseRedeemIsland) */
.license-form { overflow: hidden; }
.license-phase { opacity: 1; translate: 0 0; transition-property: opacity, translate; transition-duration: 0.24s; transition-timing-function: ease-out; }
.license-phase--from-right { opacity: 0; translate: 24px 0; }
.license-phase--from-left { opacity: 0; translate: -24px 0; }
.license-form__label { margin: 0 0 6px 2px; padding: 0; font-size: 11px; color: #d6d6d6; }
.license-form__row { flex-direction: row; align-items: center; }
.license-form__field { flex-grow: 1; flex-shrink: 1; margin: 0 8px 0 0; }
.license-form__field > .unity-text-field__input, .license-form__field .unity-base-text-field__input { min-height: 34px; padding: 0 14px; border-radius: 12px; border-width: 1px; border-color: rgba(0, 0, 0, 0); background-color: #2a2a2a; color: #ffffff; }
.license-form__field--invalid > .unity-text-field__input, .license-form__field--invalid .unity-base-text-field__input { border-color: #ff6b6b; }
.license-form__field .gallery-search__hint { top: 10px; left: 15px; }
.mcb-button.license-form__submit { height: 34px; min-height: 34px; margin: 0; padding: 0 18px; border-radius: 17px; flex-shrink: 0; }
.license-form__actions { flex-direction: row; justify-content: flex-end; margin-top: 14px; }
.license-form__actions .mcb-button { height: 30px; min-height: 30px; margin: 0 0 0 8px; padding: 0 14px; border-radius: 15px; font-size: 11px; }
.license-form__loading { flex-direction: row; justify-content: center; align-items: center; min-height: 72px; }
.license-form__loading-text { margin: 0; padding: 0; font-size: 12px; color: #c4c4c4; }
.license-form__question { margin: 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: #ffffff; }

/* ---- Cleanup window (on top of Toolkit's settings-window.uss) ---- */
.gallery-cleanup .orb-settings__card { margin-bottom: 12px; }

/* ---- Creator window ---- */
.gallery-creator-window { flex-grow: 1; background-color: #1f1f1f; }
.gallery-creator-window__scroll { flex-grow: 1; }
.gallery-creator-window .gallery-page { padding: 18px 22px 24px 22px; }
.creator-picker-note { margin: 4px 2px 0 2px; }
