/* Substance Painter card: the hero card's frame (face-tracking.uss), the VRM form rows (vrm.uss), and these. */
.painter__stage { margin: 0 0 0 6px; }
/* Painter's logo (a rounded square) in the badge, over the glow. */
.painter-logo { position: absolute; left: 9px; top: 10px; width: 60px; height: 58px; }
.ft-hero__eyebrow.painter-linked { color: #00DA6D; }
/* The actions line up with the title, as on the other cards; a wrapped row keeps a small gap. */
.painter .ft-hero__actions { margin-top: 4px; }
.painter .ft-hero__actions .mcb-button { margin-top: 6px; }
.painter-map { margin-top: 12px; }
.painter-map__set { flex-direction: row; align-items: center; overflow: hidden; text-overflow: ellipsis; }
.painter-map__live { width: 6px; height: 6px; margin-left: 6px; border-radius: 3px; background-color: #00DA6D; flex-shrink: 0; }
.painter-map__field { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.painter-footer { margin-top: 10px; }
.painter-footer .ft-note { margin-top: 0; }
.painter-buttons { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 2px; }
.painter-buttons .mcb-button { margin: 6px 6px 0 0; }

/* Open in Substance window: the posed copy on the left, the choices on the right. */
.painter-window { flex-direction: row; flex-grow: 1; background-color: #1c1c1c; }
.painter-window__view { flex-grow: 1; min-width: 200px; }
.painter-window__side { width: 330px; flex-shrink: 0; background-color: #212121; }
.painter-window__panel { flex-grow: 1; flex-shrink: 1; min-height: 0; padding: 18px 18px 8px 18px; }
.painter-window__footer { flex-shrink: 0; padding: 10px 18px 16px 18px; }
.painter-window__footer .ft-note { margin-top: 8px; }
.painter-window__label { margin-top: 6px; margin-bottom: 2px; }
.painter-window__panel .ft-hero__subtitle { margin-top: 6px; }
.painter-window__heading { margin-top: 18px; margin-bottom: 6px; }
.painter-window__chips { flex-wrap: wrap; margin-top: 6px; margin-bottom: 6px; }
.painter-window__chips .vrm-choice { margin-bottom: 6px; }
.painter-window .ft-primary { margin: 0; }
.painter-picker { margin-top: 2px; }
/* The count gives way to the buttons in the narrow side panel. */
.painter-picker .orbiters-shape-toolbar { flex-wrap: nowrap; }
.painter-picker .orbiters-shape-count { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.painter-picker .orbiters-shape-action { flex-shrink: 0; }
.painter-shapes { margin-top: 2px; }
.painter-shape { background-color: #262626; border-radius: 10px; padding: 8px 10px; margin-bottom: 6px; }
.painter-shape__name { -unity-font-style: bold; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.painter-shape__controls { flex-direction: row; align-items: center; margin-top: 6px; }
.painter-shape__weight { width: 46px; margin: 0 8px 0 0; }
.painter-shape__chip { margin: 0 6px 0 0; }
.painter-shape__weight > .unity-base-field__input { background-color: #1c1c1c; border-width: 0; border-radius: 6px; padding: 2px 6px; }
